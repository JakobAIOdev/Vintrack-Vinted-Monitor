generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                        String    @id @default(cuid())
  name                      String?
  email                     String?   @unique
  emailVerified             DateTime?
  image                     String?
  createdAt                 DateTime? @default(now()) @db.Timestamp(6)
  last_dashboard_seen_at    DateTime? @db.Timestamp(6)
  role                      String    @default("free") @db.VarChar(20)
  monitor_onboarding_status String    @default("pending") @db.VarChar(20)
  dedupe_monitor_alerts     Boolean   @default(false)
  telegram_message_style    String    @default("rich") @db.VarChar(20)
  discord_message_style     String    @default("rich") @db.VarChar(20)
  accounts                  Account[]
  sessions                  Session[]

  monitors                     monitors[]
  member_brands                member_brands[]
  proxy_groups                 proxy_groups[]
  seller_bans                  seller_bans[]
  telegram_connections         telegram_connections[]
  telegram_connect_codes       telegram_connect_codes[]
  vinted_session               vinted_sessions?
  audit_events                 audit_events[]
  alert_events                 alert_events[]
  alert_notifications          alert_notifications[]
  alert_dedupe_claims          alert_dedupe_claims[]
  monitor_runtime_sessions     monitor_runtime_sessions[]
  monitor_runtime_total        member_monitor_runtime_totals?
  github_reward_account        github_reward_accounts?
  member_reward_prompts        member_reward_prompts[]
  assigned_github_sponsorships github_sponsorships[]

  @@index([name])
  @@index([createdAt])
  @@index([last_dashboard_seen_at])
}

model github_reward_accounts {
  github_id        BigInt                @id
  login            String                @db.VarChar(255)
  account_type     String                @default("user") @db.VarChar(30)
  display_name     String?               @db.VarChar(255)
  avatar_url       String?               @db.Text
  star_status      String                @default("unknown") @db.VarChar(20)
  star_changed_at  DateTime?             @db.Timestamp(6)
  star_verified_at DateTime?             @db.Timestamp(6)
  star_event_at    DateTime?             @db.Timestamp(6)
  claimed_user_id  String?               @unique
  claimed_user     User?                 @relation(fields: [claimed_user_id], references: [id], onDelete: SetNull)
  created_at       DateTime              @default(now()) @db.Timestamp(6)
  updated_at       DateTime              @updatedAt @db.Timestamp(6)
  sponsorships     github_sponsorships[]

  @@index([login])
  @@index([star_status])
}

model github_sponsorships {
  id                  String                 @id @db.VarChar(255)
  sponsor_github_id   BigInt
  sponsor             github_reward_accounts @relation(fields: [sponsor_github_id], references: [github_id], onDelete: Cascade)
  assigned_user_id    String?
  assigned_user       User?                  @relation(fields: [assigned_user_id], references: [id], onDelete: SetNull)
  sponsorable_login   String                 @db.VarChar(255)
  is_one_time         Boolean
  is_active           Boolean
  tier_name           String?                @db.VarChar(255)
  amount_cents        Int?
  payment_source      String?                @db.VarChar(50)
  privacy_level       String?                @db.VarChar(30)
  source              String                 @db.VarChar(30)
  verification_status String                 @default("verified") @db.VarChar(30)
  sponsored_at        DateTime               @db.Timestamp(6)
  last_seen_at        DateTime               @db.Timestamp(6)
  last_verified_at    DateTime               @db.Timestamp(6)
  reward_revoked_at   DateTime?              @db.Timestamp(6)
  revoke_reason       String?                @db.Text
  created_at          DateTime               @default(now()) @db.Timestamp(6)
  updated_at          DateTime               @updatedAt @db.Timestamp(6)

  @@index([sponsor_github_id, reward_revoked_at])
  @@index([sponsorable_login, sponsored_at])
  @@index([assigned_user_id, reward_revoked_at])
}

model github_webhook_deliveries {
  delivery_id  String    @id @db.VarChar(255)
  event        String    @db.VarChar(100)
  action       String?   @db.VarChar(100)
  status       String    @default("processing") @db.VarChar(30)
  error        String?   @db.Text
  received_at  DateTime  @default(now()) @db.Timestamp(6)
  processed_at DateTime? @db.Timestamp(6)

  @@index([event, received_at])
  @@index([status, received_at])
}

model github_reward_jobs {
  id           BigInt    @id @default(autoincrement())
  job_type     String    @db.VarChar(50)
  status       String    @default("running") @db.VarChar(30)
  cursor       String?   @db.Text
  processed    Int       @default(0)
  changed      Int       @default(0)
  failed       Int       @default(0)
  metadata     Json?
  error        String?   @db.Text
  started_at   DateTime  @default(now()) @db.Timestamp(6)
  completed_at DateTime? @db.Timestamp(6)

  @@index([job_type, started_at])
  @@index([status, started_at])
}

model member_reward_prompts {
  id               BigInt    @id @default(autoincrement())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy_version   String    @db.VarChar(100)
  prompt_type      String    @db.VarChar(50)
  first_reached_at DateTime  @default(now()) @db.Timestamp(6)
  shown_at         DateTime? @db.Timestamp(6)
  dismissed_at     DateTime? @db.Timestamp(6)
  cta_clicked_at   DateTime? @db.Timestamp(6)

  @@unique([userId, policy_version, prompt_type])
  @@index([prompt_type, first_reached_at])
}

model monitor_limits {
  scope                   String   @id @db.VarChar(255)
  active_limit            Int?
  free_proxy_active_limit Int?
  created_at              DateTime @default(now()) @db.Timestamp(6)
  updated_at              DateTime @updatedAt @db.Timestamp(6)
}

model app_settings {
  key        String   @id @db.VarChar(100)
  value      String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model monitors {
  id Int @id @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                     String    @db.VarChar(255)
  query                    String    @db.Text
  title_only               Boolean   @default(false)
  anti_keywords            String?   @db.Text
  query_delay_ms           Int       @default(1500)
  quiet_hours_enabled      Boolean   @default(false)
  quiet_hours_start_minute Int       @default(0)
  quiet_hours_end_minute   Int       @default(420)
  quiet_hours_mode         String    @default("pause") @db.VarChar(20)
  quiet_hours_delay_ms     Int       @default(60000)
  quiet_hours_timezone     String    @default("Europe/Berlin") @db.VarChar(64)
  price_min                Int?
  price_max                Int?
  size_id                  String?   @db.VarChar(50)
  catalog_ids              String?   @db.VarChar(500)
  brand_ids                String?   @db.VarChar(500)
  color_ids                String?   @db.VarChar(500)
  status_ids               String?   @db.VarChar(500)
  video_game_platform_ids  String?   @db.VarChar(500)
  region                   String    @default("de") @db.VarChar(10)
  allowed_countries        String?   @db.VarChar(500)
  min_seller_rating        Float?
  min_seller_rating_count  Int?
  status                   String?   @default("active") @db.VarChar(50)
  created_at               DateTime? @default(now()) @db.Timestamp(6)
  demo_expires_at          DateTime? @db.Timestamp(6)
  active_since             DateTime? @db.Timestamp(6)
  runtime_total_seconds    BigInt    @default(0)
  items                    items[]
  discord_webhook          String?
  webhook_active           Boolean   @default(true)
  telegram_active          Boolean   @default(false)
  notifications_enabled    Boolean   @default(true)

  proxy_group_id      Int?
  proxy_source        String                     @default("server") @db.VarChar(20)
  proxy_group         proxy_groups?              @relation(fields: [proxy_group_id], references: [id], onDelete: SetNull)
  monitor_runs        monitor_runs[]
  hourly_stats        monitor_run_hourly_stats[]
  monitor_events      monitor_events[]
  alert_events        alert_events[]
  alert_notifications alert_notifications[]
  proxy_incidents     monitor_proxy_incidents[]
  item_detections     monitor_item_detections[]
  runtime_sessions    monitor_runtime_sessions[]

  @@index([userId])
  @@index([status, userId])
}

model monitor_runtime_sessions {
  id           BigInt    @id @default(autoincrement())
  monitor_id   Int?
  monitor      monitors? @relation(fields: [monitor_id], references: [id], onDelete: SetNull)
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  proxy_source String    @db.VarChar(20)
  started_at   DateTime  @db.Timestamp(6)
  ended_at     DateTime? @db.Timestamp(6)
}

model member_monitor_runtime_totals {
  user_id                String   @id
  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  closed_runtime_seconds BigInt   @default(0)
  updated_at             DateTime @updatedAt @db.Timestamp(6)
}

model free_proxies {
  id                  Int                 @id @default(autoincrement())
  proxy_url           String              @unique @db.VarChar(500)
  protocol            String              @db.VarChar(20)
  host                String              @db.VarChar(255)
  port                Int
  source              String              @default("manual") @db.VarChar(50)
  sources             String[]            @default([])
  status              String              @default("active") @db.VarChar(30)
  success_count       Int                 @default(0)
  failure_count       Int                 @default(0)
  last_checked_at     DateTime?           @db.Timestamp(6)
  last_success_at     DateTime?           @db.Timestamp(6)
  last_failure_at     DateTime?           @db.Timestamp(6)
  quarantined_until   DateTime?           @db.Timestamp(6)
  check_claimed_until DateTime?           @db.Timestamp(6)
  last_error          String?             @db.Text
  last_error_code     String?             @db.VarChar(50)
  last_error_stage    String?             @db.VarChar(20)
  last_seen_at        DateTime?           @db.Timestamp(6)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  updated_at          DateTime            @updatedAt @db.Timestamp(6)
  health              free_proxy_health[]

  @@index([status, quarantined_until])
  @@index([check_claimed_until])
  @@index([source])
  @@index([last_seen_at])
}

model free_proxy_health {
  id                     BigInt       @id @default(autoincrement())
  proxy_id               Int
  proxy                  free_proxies @relation(fields: [proxy_id], references: [id], onDelete: Cascade)
  region                 String       @db.VarChar(10)
  status                 String       @default("pending") @db.VarChar(30)
  success_streak         Int          @default(0)
  failure_streak         Int          @default(0)
  success_count          Int          @default(0)
  failure_count          Int          @default(0)
  latency_ms             Int?
  last_status_code       Int?
  last_error             String?      @db.Text
  last_error_code        String?      @db.VarChar(50)
  last_error_stage       String?      @db.VarChar(20)
  last_checked_at        DateTime?    @db.Timestamp(6)
  last_success_at        DateTime?    @db.Timestamp(6)
  last_failure_at        DateTime?    @db.Timestamp(6)
  next_check_at          DateTime?    @db.Timestamp(6)
  candidate_window_token BigInt?      @default(dbgenerated("FLOOR(EXTRACT(EPOCH FROM NOW()) / 3600)::bigint"))
  score                  Int          @default(0)
  created_at             DateTime     @default(now()) @db.Timestamp(6)
  updated_at             DateTime     @updatedAt @db.Timestamp(6)

  @@unique([proxy_id, region])
  @@index([region, status, next_check_at])
  @@index([region, last_error_stage], map: "free_proxy_health_region_error_stage_idx")
  @@index([region, last_checked_at])
  @@index([region, last_success_at])
  @@index([region, candidate_window_token], map: "free_proxy_health_region_candidate_window_idx")
  @@index([region, candidate_window_token, next_check_at, status], map: "free_proxy_health_window_due_idx")
  @@index([status, score])
}

model free_proxy_source_health_stats {
  region          String    @db.VarChar(10)
  source          String    @db.VarChar(50)
  protocol        String    @db.VarChar(20)
  checked_count   Int       @default(0)
  success_count   Int       @default(0)
  failure_count   Int       @default(0)
  last_checked_at DateTime? @db.Timestamp(6)
  last_success_at DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)

  @@id([region, source, protocol])
  @@index([region, success_count, checked_count], map: "free_proxy_source_health_stats_region_yield_idx")
}

model monitor_runs {
  id             BigInt   @id @default(autoincrement())
  monitor_id     Int
  monitor        monitors @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  status         String   @db.VarChar(50)
  status_code    Int?
  duration_ms    Int?
  item_count     Int      @default(0)
  new_item_count Int      @default(0)
  error_message  String?  @db.Text
  proxy_source   String?  @db.VarChar(255)
  fetch_source   String   @default("canonical") @db.VarChar(20)
  region         String   @db.VarChar(10)
  checked_at     DateTime @default(now()) @db.Timestamp(6)

  @@index([monitor_id, checked_at])
  @@index([monitor_id, fetch_source, checked_at])
  @@index([checked_at, monitor_id])
  @@index([status])
}

model monitor_run_hourly_stats {
  monitor_id             Int
  monitor                monitors  @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  bucket_hour            DateTime  @db.Timestamp(6)
  fetch_source           String    @default("canonical") @db.VarChar(20)
  check_count            BigInt    @default(0)
  successful_check_count BigInt    @default(0)
  failed_check_count     BigInt    @default(0)
  new_item_count         BigInt    @default(0)
  duration_total_ms      BigInt    @default(0)
  duration_sample_count  BigInt    @default(0)
  last_checked_at        DateTime  @db.Timestamp(6)
  latest_error           String?   @db.Text
  latest_error_at        DateTime? @db.Timestamp(6)
  latest_status_code     Int?

  @@id([monitor_id, fetch_source, bucket_hour])
  @@index([fetch_source, bucket_hour])
}

model monitor_item_detections {
  monitor_id        Int
  monitor           monitors  @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  item_id           BigInt
  first_source      String    @db.VarChar(20)
  early_seen_at     DateTime? @db.Timestamp(6)
  canonical_seen_at DateTime? @db.Timestamp(6)
  alert_queued_at   DateTime? @db.Timestamp(6)
  alert_sent_at     DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)

  @@id([monitor_id, item_id])
  @@index([monitor_id, created_at])
  @@index([created_at])
}

model item_preindex_samples {
  region        String   @db.VarChar(10)
  item_id       BigInt
  slug          String?  @db.VarChar(500)
  first_seen_at DateTime @db.Timestamp(6)
  proxy_source  String?  @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@id([region, item_id])
  @@index([region, first_seen_at])
  @@index([first_seen_at])
}

model preindex_probe_runs {
  id           BigInt   @id @default(autoincrement())
  region       String   @db.VarChar(10)
  item_id      BigInt
  status_code  Int?
  duration_ms  Int?
  outcome      String   @db.VarChar(30)
  proxy_source String?  @db.VarChar(255)
  checked_at   DateTime @default(now()) @db.Timestamp(6)

  @@index([region, checked_at])
  @@index([outcome, checked_at])
}

model monitor_events {
  id         BigInt   @id @default(autoincrement())
  monitor_id Int
  monitor    monitors @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  event_type String   @db.VarChar(100)
  severity   String   @default("info") @db.VarChar(20)
  message    String   @db.Text
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@index([monitor_id, created_at])
  @@index([event_type])
  @@index([created_at])
}

model audit_events {
  id          BigInt   @id @default(autoincrement())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(100)
  target_type String?  @db.VarChar(100)
  target_id   String?  @db.VarChar(255)
  status      String   @default("success") @db.VarChar(50)
  metadata    Json?
  created_at  DateTime @default(now()) @db.Timestamp(6)

  @@index([userId, created_at])
  @@index([action])
}

model alert_events {
  id                BigInt               @id @default(autoincrement())
  userId            String?
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  monitor_id        Int?
  monitor           monitors?            @relation(fields: [monitor_id], references: [id], onDelete: SetNull)
  item_id           BigInt?
  notification_id   BigInt?
  notification      alert_notifications? @relation(fields: [notification_id], references: [id], onDelete: SetNull)
  delivery_id       BigInt?
  delivery          alert_deliveries?    @relation(fields: [delivery_id], references: [id], onDelete: SetNull)
  channel           String               @db.VarChar(50)
  status            String               @db.VarChar(50)
  notification_kind String               @default("item_match") @db.VarChar(50)
  reason_code       String?              @db.VarChar(50)
  attempt_number    Int?
  failure_reason    String?              @db.Text
  metadata          Json?
  created_at        DateTime             @default(now()) @db.Timestamp(6)

  @@index([userId, created_at])
  @@index([monitor_id, created_at])
  @@index([item_id])
  @@index([notification_id])
  @@index([delivery_id])
  @@index([channel, status])
  @@index([created_at])
  @@index([status, created_at])
}

model alert_dedupe_claims {
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  item_id    BigInt
  claimed_at DateTime @default(now()) @db.Timestamp(6)
  expires_at DateTime @db.Timestamp(6)

  @@id([user_id, item_id])
  @@index([expires_at])
}

model alert_notifications {
  id              BigInt             @id @default(autoincrement())
  user_id         String?
  user            User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)
  monitor_id      Int?
  monitor         monitors?          @relation(fields: [monitor_id], references: [id], onDelete: SetNull)
  item_id         BigInt?
  kind            String             @db.VarChar(50)
  payload_version Int                @default(1)
  payload         Json
  idempotency_key String             @unique @db.VarChar(255)
  expires_at      DateTime           @db.Timestamp(6)
  created_at      DateTime           @default(now()) @db.Timestamp(6)
  deliveries      alert_deliveries[]
  events          alert_events[]

  @@index([user_id, created_at])
  @@index([monitor_id, created_at])
}

model alert_deliveries {
  id                      BigInt              @id @default(autoincrement())
  notification_id         BigInt
  notification            alert_notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  channel                 String              @db.VarChar(20)
  status                  String              @default("pending") @db.VarChar(20)
  destination_fingerprint String              @db.VarChar(64)
  attempt_count           Int                 @default(0)
  next_attempt_at         DateTime            @default(now()) @db.Timestamp(6)
  lease_until             DateTime?           @db.Timestamp(6)
  claim_token             String?             @db.VarChar(64)
  last_reason_code        String?             @db.VarChar(50)
  last_error_detail       String?             @db.Text
  completed_at            DateTime?           @db.Timestamp(6)
  created_at              DateTime            @default(now()) @db.Timestamp(6)
  updated_at              DateTime            @updatedAt @db.Timestamp(6)
  events                  alert_events[]

  @@unique([notification_id, channel])
  @@index([status, next_attempt_at])
  @@index([destination_fingerprint, status, created_at])
  @@index([lease_until])
}

model alert_event_hourly_stats {
  bucket_hour       DateTime @db.Timestamp(6)
  channel           String   @db.VarChar(20)
  notification_kind String   @db.VarChar(50)
  outcome           String   @db.VarChar(30)
  reason_code       String   @default("") @db.VarChar(50)
  event_count       BigInt   @default(0)
  last_seen_at      DateTime @db.Timestamp(6)

  @@id([bucket_hour, channel, notification_kind, outcome, reason_code])
  @@index([bucket_hour, outcome])
}

model monitor_proxy_incidents {
  id           BigInt    @id @default(autoincrement())
  monitor_id   Int
  monitor      monitors  @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  domain       String    @db.VarChar(255)
  proxy_source String    @db.VarChar(20)
  started_at   DateTime  @default(now()) @db.Timestamp(6)
  last_wait_at DateTime  @default(now()) @db.Timestamp(6)
  retry_at     DateTime? @db.Timestamp(6)
  wait_count   Int       @default(1)
  recovered_at DateTime? @db.Timestamp(6)
  end_reason   String?   @db.VarChar(30)

  @@index([monitor_id, started_at])
  @@index([started_at])
  @@index([recovered_at])
}

model telegram_connections {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chat_id    String
  chat_type  String?  @db.VarChar(50)
  chat_title String?  @db.VarChar(255)
  username   String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
}

model telegram_connect_codes {
  id     Int    @id @default(autoincrement())
  code   String @unique @db.VarChar(32)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expires_at DateTime  @db.Timestamp(6)
  used_at    DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
}

model items {
  id                 BigInt
  monitor_id         Int
  title              String?   @db.VarChar(500)
  brand              String?   @db.VarChar(100)
  price              String?   @db.VarChar(50)
  total_price        String?   @db.VarChar(50)
  size               String?   @db.VarChar(100)
  condition          String?   @db.VarChar(100)
  location           String?
  rating             String?   @db.VarChar(50)
  seller_id          BigInt?
  seller_login       String?   @db.VarChar(255)
  seller_profile_url String?
  url                String?
  image_url          String?
  extra_images       String[]  @default([])
  found_at           DateTime? @default(now()) @db.Timestamp(6)
  monitors           monitors  @relation(fields: [monitor_id], references: [id], onDelete: Cascade)

  @@id([id, monitor_id])
  @@index([monitor_id, found_at])
  @@index([seller_id])
}

model seller_bans {
  id                 BigInt   @id @default(autoincrement())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller_id          BigInt
  seller_login       String?  @db.VarChar(255)
  seller_profile_url String?
  created_at         DateTime @default(now()) @db.Timestamp(6)

  @@unique([userId, seller_id])
  @@index([seller_id])
}

model member_brands {
  id            BigInt   @id @default(autoincrement())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand_id      BigInt
  label         String   @db.VarChar(255)
  canonical_url String   @db.Text
  source_region String   @db.VarChar(10)
  active        Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  @@unique([userId, brand_id])
  @@index([userId, active])
  @@index([brand_id])
}

model proxy_groups {
  id Int @id @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                     String     @db.VarChar(100)
  proxies                  String     @db.Text
  bandwidth_rx_bytes       BigInt     @default(0)
  bandwidth_tx_bytes       BigInt     @default(0)
  bandwidth_limit_bytes    BigInt?
  bandwidth_reset_at       DateTime?  @db.Timestamp(6)
  proxy_check_status       String     @default("idle") @db.VarChar(20)
  proxy_check_region       String?    @db.VarChar(10)
  proxy_check_total        Int        @default(0)
  proxy_check_checked      Int        @default(0)
  proxy_check_working      Int        @default(0)
  proxy_check_slow         Int        @default(0)
  proxy_check_failed       Int        @default(0)
  proxy_check_results      Json?
  proxy_check_error        String?    @db.Text
  proxy_check_requested_at DateTime?  @db.Timestamp(6)
  proxy_check_started_at   DateTime?  @db.Timestamp(6)
  proxy_check_completed_at DateTime?  @db.Timestamp(6)
  created_at               DateTime?  @default(now()) @db.Timestamp(6)
  monitors                 monitors[]

  @@index([userId])
  @@index([proxy_check_status, proxy_check_requested_at])
}

model vinted_sessions {
  id                       Int       @id @default(autoincrement())
  userId                   String    @unique @map("user_id")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vinted_user_id           BigInt    @default(0)
  vinted_name              String    @default("")
  access_token_ciphertext  String    @db.Text
  refresh_token_ciphertext String?   @db.Text
  cookie_header_ciphertext String?   @db.Text
  csrf_token_ciphertext    String?   @db.Text
  anon_id_ciphertext       String?   @db.Text
  user_agent               String?   @db.Text
  phone_number_ciphertext  String?   @db.Text
  browser_linked           Boolean   @default(false)
  domain                   String    @db.VarChar(255)
  status                   String    @default("active") @db.VarChar(50)
  linked_at                DateTime? @db.Timestamp(6)
  last_check               DateTime? @db.Timestamp(6)
  warmed_at                DateTime? @db.Timestamp(6)
  last_browser_sync_at     DateTime? @db.Timestamp(6)
  last_refresh_at          DateTime? @db.Timestamp(6)
  last_valid_at            DateTime? @db.Timestamp(6)
  invalid_reason           String?   @db.Text
  created_at               DateTime  @default(now()) @db.Timestamp(6)
  updated_at               DateTime  @updatedAt @db.Timestamp(6)

  @@index([status])
  @@index([last_check])
}
