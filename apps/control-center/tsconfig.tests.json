{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "ES2020",
        "allowImportingTsExtensions": true,
        "incremental": false
    },
    "include": [
        "next-env.d.ts",
        "next.config.ts",
        "playwright.config.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.mts"
    ],
    "exclude": ["node_modules", "prisma.config.ts"]
}
