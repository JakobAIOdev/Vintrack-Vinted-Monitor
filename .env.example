# =============================================================================
# Vintrack Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# --- Discord OAuth (for NextAuth login) ---
# Create an app at https://discord.com/developers/applications
# Set the OAuth2 redirect URL to: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=your_discord_client_id
AUTH_DISCORD_SECRET=your_discord_client_secret
# Optional second login provider and GitHub reward identity.
# Callback: https://your-domain.example/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000
# Canonical origin used in Discord/Telegram links. Production:
# https://vintrack.jakobaio.dev
APP_PUBLIC_URL=http://localhost:3000
# Search indexing is opt-in so self-hosted instances do not publish duplicate
# marketing pages accidentally. The official public deployment sets this true.
SEO_INDEXING_ENABLED=false
# Legacy fallback; keep identical to APP_PUBLIC_URL until removed.
DASHBOARD_URL=http://localhost:3000
# Caddy site address. Set to your public hostname (without a path) in production.
VINTRACK_SITE_ADDRESS=http://localhost

# --- OIDC Authentication (optional, replaces Discord, e.g. Authentik, Google, Keycloak) ---
# Set these to use an OIDC provider instead of Discord.
# When set, Discord login is disabled and only OIDC is used.
# Existing Discord accounts are not automatically linked to OIDC accounts.
# The callback URL must be: {AUTH_URL}/api/auth/callback/oidc
# AUTH_OIDC_ISSUER=https://your-oidc-provider.com/application/o/your-app/
# AUTH_OIDC_CLIENT_ID=your_oidc_client_id
# AUTH_OIDC_CLIENT_SECRET=your_oidc_client_secret
# AUTH_OIDC_NAME=Authentik

# --- NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here

# GitHub reward webhooks and recovery sync. Use separate random webhook secrets.
GITHUB_REPOSITORY_WEBHOOK_SECRET=
GITHUB_SPONSORS_WEBHOOK_SECRET=
# Token belonging to the sponsored account; used to backfill stargazers and
# private/historical GitHub Sponsors relationships through the GraphQL API.
GITHUB_REWARDS_MAINTAINER_TOKEN=
# Random bearer secret shared only with the scheduler container.
GITHUB_REWARDS_SYNC_SECRET=

# --- Vinted Session Storage ---
# Generate with: openssl rand -base64 32
VINTED_SESSION_ENCRYPTION_KEY=your_random_session_encryption_key_here

# --- Browser Extension Compatibility ---
# Latest version shown as available; minimum version hard-blocks extension actions.
BROWSER_EXTENSION_LATEST_VERSION=0.1.6
BROWSER_EXTENSION_MIN_VERSION=0.1.5
# Public AMO listing used by the dashboard and setup guide.
BROWSER_EXTENSION_FIREFOX_URL=https://addons.mozilla.org/firefox/addon/vintrack-browser-sync/

# --- Database ---
# The bundled PostgreSQL defaults and internal URLs are defined in docker-compose.yml.

# --- Worker ---
# Per-monitor query delay is configured in the dashboard.
# CHECK_INTERVAL_MS is only a legacy fallback for invalid monitor rows.
# PROXY_FILE=proxies.txt
# Set VINTED_FETCH_MODE=mock for frontend/dev testing without real Vinted requests.
# VINTED_FETCH_MODE=live
# VINTED_MOCK_SCENARIO=new-items
# VINTED_MOCK_DROP_INTERVAL_MS=3000
# Hybrid discovery defaults off. Start in shadow mode and review metrics before active alerts.
# DISCOVERY_MODE=off
# Shadow mode includes free proxies for measurement. Active free alerts require explicit opt-in.
# DISCOVERY_ALLOW_FREE_ACTIVE=false
# DISCOVERY_INTERVAL_MS=500
# DISCOVERY_FREE_INTERVAL_MS=500
# DISCOVERY_PER_PAGE=96
# DISCOVERY_FREE_PER_PAGE=64
# DISCOVERY_MAX_BACKFILL_PAGES=3
# DISCOVERY_FREE_CLIENT_POOL_SIZE=8
# DISCOVERY_FREE_TIMEOUT_MS=3000
# DISCOVERY_FREE_HEDGE_DELAY_MS=150
# Dedicated proxy sessions should stay on one exit IP for the lifetime of a client.
# CLIENT_POOL_SIZE=5
# FREE_PROXY_CLIENT_POOL_SIZE=50
# TLS_PROFILE=chrome_146
# CATALOG_TIMEOUT_MS=2000
# CATALOG_HEDGE_DELAY_MS=250
# FREE_PROXY_CATALOG_HEDGE_DELAY_MS=900
# ALERT_WORKERS=8
# ALERT_DELIVERY_WORKERS=16
# Individual item Price Watch. Pages are scanned as a stream and never buffered
# in full; 3 MiB leaves room for Vinted's current ~2 MiB item documents.
# PRICE_WATCH_ENABLED=true
# PRICE_WATCH_WORKERS=4
# auto: server proxies in production; development may fall back to direct.
# PRICE_WATCH_TRANSPORT_MODE=auto
# PRICE_WATCH_CLIENT_POOL_SIZE=4
# PRICE_WATCH_TIMEOUT_MS=6000
# PRICE_WATCH_HTML_LIMIT_BYTES=3145728
# One Telegram bot token serves every member, so the send rate is shared.
# Stay below Telegram's bot-wide ceiling instead of discovering it through 429s.
# TELEGRAM_GLOBAL_RATE_PER_SECOND=25
# TELEGRAM_GLOBAL_BURST=25
# ENRICHMENT_WORKERS=24
# SELLER_ENRICHMENT_TIMEOUT_MS=2000
# SELLER_CLIENT_POOL_SIZE=16
# SELLER_CACHE_TTL_MINUTES=30
# SELLER_HEDGE_DELAY_MS=350
# SELLER_NEGATIVE_CACHE_TTL_MS=3000
# In-worker fetch/process latency aggregation (p50/p95 to app_settings); set false to disable.
# CATALOG_LATENCY_METRICS=true
# Raw monitor checks are aggregated hourly and kept only for short-term diagnostics.
# MONITOR_RUN_RETENTION_HOURS=24
# MONITOR_RUN_STATS_RETENTION_DAYS=90
# DETECTION_RETENTION_DAYS=14
# ALERT_SUCCESS_RETENTION_DAYS=7
# ALERT_FAILURE_RETENTION_DAYS=30
# ALERT_STATS_RETENTION_DAYS=90
# OPERATIONAL_EVENT_RETENTION_DAYS=30
# Free-proxy maintenance uses bounded batches so validation cannot exhaust the
# database pool or monopolize the worker host.
# FREE_PROXY_HEALTH_CONCURRENCY=64
# Hard cap for concurrent validation requests to one Vinted regional domain.
# FREE_PROXY_HEALTH_PER_REGION_CONCURRENCY=12
# Per-region cycle budgets; the maintainer claims at most one bounded wave at a time.
# FREE_PROXY_HEALTH_BATCH_PER_REGION=100
# FREE_PROXY_BOOTSTRAP_BATCH_PER_REGION=600
# Pre-index ID sampling is an isolated, shadow-only experiment. It never sends alerts.
# ID_SCANNER_ENABLED=false
# Enable the optional Compose service with COMPOSE_PROFILES=preindex.
# COMPOSE_PROFILES=preindex
# ID_SCANNER_REGION=de
# ID_SCANNER_STRIDE=100
# ID_SCANNER_INTERVAL_MS=500
# ID_SCANNER_JITTER_MS=200
# ID_SCANNER_TIMEOUT_MS=2000
# ID_SCANNER_POOL_SIZE=16
# Leaves the highest-ranked free proxies to canonical and hybrid monitoring.
# ID_SCANNER_PROXY_OFFSET=32
# ID_SCANNER_STUCK_SKIP_AFTER=10
# ID_SCANNER_MAX_AHEAD=10000
# PREINDEX_PROBE_RETENTION_HOURS=48
# PREINDEX_SAMPLE_RETENTION_DAYS=14

# --- Telegram Notifications ---
# Create a bot with @BotFather and paste the token here.
# Users connect Telegram from the dashboard with a one-time code; the token stays server-side.
TELEGRAM_BOT_TOKEN=
# Public bot username without @, used to open Telegram from the dashboard.
TELEGRAM_BOT_USERNAME=
# Optional: pass this when calling Telegram setWebhook and Vintrack will verify it.
TELEGRAM_WEBHOOK_SECRET=
# One-time setup after deploy:
# curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=https://your-domain.com/api/telegram/webhook&secret_token=$TELEGRAM_WEBHOOK_SECRET"

# --- Host resources ---
# Defaults suit a small single-host VPS (roughly 2 GB RAM). Raise them together
# with the container limits when running on larger hardware.
# POSTGRES_SHARED_BUFFERS=128MB
# Must reflect memory actually available for caching. The PostgreSQL default of
# 4GB makes the planner assume warm cache that a small host does not have.
# POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
# Applies per autovacuum worker, so it multiplies by POSTGRES_AUTOVACUUM_MAX_WORKERS.
# POSTGRES_MAINTENANCE_WORK_MEM=48MB
# POSTGRES_AUTOVACUUM_MAX_WORKERS=2
# POSTGRES_WORK_MEM=4MB
# POSTGRES_MAX_CONNECTIONS=50
# POSTGRES_SHM_SIZE=256m
# Monitor telemetry is high volume and disposable, so it does not belong in the
# fsync path. Set to "on" if losing a fraction of a second of committed
# transactions after a hard crash is unacceptable for your deployment.
# POSTGRES_SYNCHRONOUS_COMMIT=off
# REDIS_MAXMEMORY=192mb

# Container memory limits. Without them the kernel OOM killer is the only
# arbiter, and killing the worker discards every alert that has not reached the
# durable outbox yet.
# Postgres is intentionally unlimited: a cgroup limit does not reduce its
# memory use, it makes the kernel kill a backend when the limit is hit, and
# losing Postgres takes the whole stack down. Set this only against measured
# usage.
# POSTGRES_MEM_LIMIT=0
# REDIS_MEM_LIMIT=320m
# CONTROL_CENTER_MEM_LIMIT=512m
# CONTROL_CENTER_HEAP_MB=320
# WORKER_MEM_LIMIT=384m
# WORKER_GOMEMLIMIT=340MiB
# WORKER_GOGC=80
# PROXY_MAINTAINER_MEM_LIMIT=200m
# PROXY_MAINTAINER_GOMEMLIMIT=180MiB
# VINTED_SERVICE_MEM_LIMIT=128m
# CADDY_MEM_LIMIT=64m
# Prisma otherwise derives its pool size from the host CPU count.
# PRISMA_CONNECTION_LIMIT=5

# Connection pools. The Go default (host CPU count x 4) ignores container limits
# and scales with hardware instead of load. Keep the sum of every pool below
# POSTGRES_MAX_CONNECTIONS: worker 20+1, proxy-maintainer 6+2+1,
# vinted-service 4, Prisma 5.
# WORKER_DB_MAX_OPEN_CONNS=20
# The alert outbox runs on its own pool so an enqueue never waits behind monitor
# or telemetry traffic.
# ALERT_DB_POOL_SIZE=6
# PROXY_MAINTAINER_DB_MAX_OPEN_CONNS=6
# PROXY_MAINTAINER_ALERT_DB_POOL_SIZE=2
